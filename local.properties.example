# Скопируй этот файл в local.properties и заполни значения

# VK App ID
# Как получить:
# 1. Зайди на https://vk.com/editapp?act=create
# 2. Выбери тип "Standalone-приложение"
# 3. После создания скопируй ID приложения (число вверху страницы)
VK_APP_ID=your_vk_app_id_here

# Keystore (только для Release сборки)
# KEYSTORE_PATH=keystore.jks
# KEYSTORE_PASS=your_keystore_password
# KEY_ALIAS=your_key_alias
# KEY_PASS=your_key_password
